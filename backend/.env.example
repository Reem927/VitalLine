# Copy to backend/.env and fill in. Never commit backend/.env.

# Model: one setting picks the LLM, "provider:model". Blank = google_genai:gemini-2.5-flash.
# Anthropic also works, e.g. MODEL_NAME=anthropic:claude-sonnet-5-5 with ANTHROPIC_API_KEY.
# With no key the backend runs the same steps with the rules engine (no LLM).
MODEL_NAME=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Set to 1 to force the rules engine even when a key is present.
AGENTS_DISABLED=

# CoStar toolkit (property data, Matterport scans, Vexcel imagery).
# Variable names may change once the keys arrive.
COSTAR_API_KEY=
MATTERPORT_API_KEY=
VEXCEL_API_KEY=

# Wolfram|Alpha AppID (Short Answers API). Blank = exact local arithmetic only.
WOLFRAM_API_KEY=

# Outdoor routing. Blank uses the public instance.
VALHALLA_URL=

# Storage. Set both Supabase values to use Supabase (run connectors/supabase_schema.sql first);
# otherwise a local SQLite file is used (SQLITE_PATH, default data/vitalline.db).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SQLITE_PATH=

# Set to 1 to make no outbound HTTP calls (fallbacks are used and labelled).
VITALLINE_OFFLINE=

# LangSmith tracing (event log stores the trace id per agent step)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
