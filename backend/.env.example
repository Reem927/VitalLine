# Copy to backend/.env and fill in. Never commit backend/.env.

# Model: one setting picks the LLM. Leave blank for the default (Gemini).
MODEL_NAME=
GOOGLE_API_KEY=

# CoStar track keys: run /costar-keys in the track Discord.
# Matterport Model API uses HTTP basic auth: key is the user, token is the password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Vexcel key goes in the X-API-KEY header. Houston, Los Angeles and Princeton only.
VEXCEL_API_KEY=
# CoStar data kit: zip of property records, read in place over HTTP.
COSTAR_KIT_URL=
COSTAR_ZIP_PASSWORD=

# Wolfram math verification
WOLFRAM_API_KEY=

# Outdoor routing. Blank uses the public instance.
VALHALLA_URL=
# Ambulance size from the agency's vehicle spec, in metres. Blank routes without size limits.
VEHICLE_HEIGHT_M=
VEHICLE_WIDTH_M=

# Supabase. The service key stays on the server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LangSmith tracing
LANGSMITH_API_KEY=
