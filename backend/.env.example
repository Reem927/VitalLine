# Copy to backend/.env and fill in. Never commit backend/.env.

# Model: one setting picks the LLM. Leave blank for the default (Gemini).
MODEL_NAME=
GOOGLE_API_KEY=

# CoStar toolkit (property data, Matterport scans, Vexcel imagery).
# Variable names may change once the keys arrive.
COSTAR_API_KEY=
MATTERPORT_API_KEY=
VEXCEL_API_KEY=

# Wolfram math verification
WOLFRAM_API_KEY=

# Outdoor routing. Blank uses the public instance.
VALHALLA_URL=

# Supabase. The service key stays on the server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LangSmith tracing
LANGSMITH_API_KEY=
